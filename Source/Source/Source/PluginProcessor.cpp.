#include "PluginProcessor.h"
#include <cmath>

using Layout = juce::AudioProcessorValueTreeState::ParameterLayout;

static std::unique_ptr<juce::AudioParameterFloat> makeFloat (const char* id, const char* name,
                                                             float lo, float hi, float step,
                                                             float def, const char* unit)
{
    return std::make_unique<juce::AudioParameterFloat> (
        juce::ParameterID { id, 1 }, name,
        juce::NormalisableRange<float> (lo, hi, step), def,
        juce::AudioParameterFloatAttributes().withLabel (unit));
}

Layout EiyesVocalAudioProcessor::createLayout()
{
    Layout l;
    // Cleanup / tone
    l.add (makeFloat ("hpf",      "Low Cut",         20.f,  300.f, 1.f,  90.f, "Hz"));
    l.add (makeFloat ("mud",      "Mud Cut 300Hz",  -12.f,    6.f, 0.1f, -2.f, "dB"));
    l.add (makeFloat ("presence", "Presence 4kHz",   -6.f,    9.f, 0.1f,  2.f, "dB"));
    l.add (makeFloat ("air",      "Air 11kHz",       -6.f,    9.f, 0.1f,  2.f, "dB"));
    // Compressor
    l.add (makeFloat ("thresh",   "Comp Threshold", -40.f,    0.f, 0.1f, -18.f, "dB"));
    l.add (makeFloat ("ratio",    "Comp Ratio",       1.f,   10.f, 0.1f,  4.f, ":1"));
    // Pitch layer
    l.add (makeFloat ("pitch",    "Pitch Shift",    -12.f,   12.f, 0.01f, 5.f, "st"));
    l.add (makeFloat ("layer",    "Pitch Layer Level", -30.f, 0.f, 0.1f, -10.f, "dB"));
    l.add (std::make_unique<juce::AudioParameterBool> (juce::ParameterID { "replace", 1 },
                                                       "Pitch Replace (voice only)", false));
    // Delay
    l.add (makeFloat ("dtime",    "Delay Time",       1.f,  500.f, 1.f,  180.f, "ms"));
    l.add (makeFloat ("dfb",      "Delay Feedback",   0.f,   0.9f, 0.01f, 0.2f, ""));
    l.add (makeFloat ("dmix",     "Delay Mix",        0.f,    1.f, 0.01f, 0.12f, ""));
    // Reverb
    l.add (makeFloat ("rsize",    "Reverb Size",      0.f,    1.f, 0.01f, 0.3f, ""));
    l.add (makeFloat ("rmix",     "Reverb Mix",       0.f,    1.f, 0.01f, 0.12f, ""));
    // Output
    l.add (makeFloat ("out",      "Output",         -24.f,   12.f, 0.1f,  0.f, "dB"));
    return l;
}

EiyesVocalAudioProcessor::EiyesVocalAudioProcessor()
    : AudioProcessor (BusesProperties()
                          .withInput  ("Input",  juce::AudioChannelSet::stereo(), true)
                          .withOutput ("Output", juce::AudioChannelSet::stereo(), true)),
      apvts (*this, nullptr, "PARAMS", createLayout())
{
}

bool EiyesVocalAudioProcessor::isBusesLayoutSupported (const BusesLayout& layouts) const
{
    const auto& out = layouts.getMainOutputChannelSet();
    if (out != juce::AudioChannelSet::mono() && out != juce::AudioChannelSet::stereo())
        return false;
    return layouts.getMainInputChannelSet() == out;
}

void EiyesVocalAudioProcessor::updateFilters (float hpfHz, float mudDb, float presenceDb, float airDb)
{
    using C = juce::dsp::IIR::Coefficients<float>;
    if (hpfHz != lastHpf)
    {
        auto c = C::makeHighPass (sr, hpfHz);
        for (auto& f : hpf) f.coefficients = c;
        lastHpf = hpfHz;
    }
    if (mudDb != lastMud)
    {
        auto c = C::makePeakFilter (sr, 300.0, 1.0, juce::Decibels::decibelsToGain (mudDb));
        for (auto& f : mud) f.coefficients = c;
        lastMud = mudDb;
    }
    if (presenceDb != lastPresence)
    {
        auto c = C::makePeakFilter (sr, 4000.0, 0.8, juce::Decibels::decibelsToGain (presenceDb));
        for (auto& f : presence) f.coefficients = c;
        lastPresence = presenceDb;
    }
    if (airDb != lastAir)
    {
        auto c = C::makeHighShelf (sr, 11000.0, 0.7, juce::Decibels::decibelsToGain (airDb));
        for (auto& f : air) f.coefficients = c;
        lastAir = airDb;
    }
}

void EiyesVocalAudioProcessor::prepareToPlay (double sampleRate, int)
{
    sr = sampleRate;
    lastHpf = -1.f; lastMud = lastPresence = lastAir = -100.f;
    updateFilters (param ("hpf"), param ("mud"), param ("presence"), param ("air"));

    auto layerCoeffs = juce::dsp::IIR::Coefficients<float>::makeHighPass (sr, 300.0);
    for (int ch = 0; ch < maxCh; ++ch)
    {
        hpf[ch].reset(); mud[ch].reset(); presence[ch].reset(); air[ch].reset(); layerHp[ch].reset();
        layerHp[ch].coefficients = layerCoeffs;
        shifter[ch].prepare (sr);
        delayLine[ch].prepare (sr, 1.0f);
    }
    compressor.prepare (sr);
    reverb.setSampleRate (sr);
    reverb.reset();

    smoothedRatio = std::pow (2.0f, param ("pitch") / 12.0f);
    smoothedDelay = (float) (param ("dtime") * 0.001 * sr);
    lastOutGain = juce::Decibels::decibelsToGain (param ("out"));
}

void EiyesVocalAudioProcessor::processBlock (juce::AudioBuffer<float>& buffer, juce::MidiBuffer&)
